  "info": {
    "_postman_id": "6d5d6fe7-02ab-472f-a726-ad62102ff30f",
    "name": "Pushwoosh Messaging API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Pushwoosh is a customer engagement platform offering push notifications,\nin-app messaging, email, SMS, and Live Activities for mobile and web.\nThe Messaging API (v1.3) exposes JSON-RPC-style endpoints for creating\nand managing messages, targeted campaigns, and message details.\nAuthentication is performed by including the `auth` field (API access\ntoken from the Pushwoosh Control Panel) in the JSON request body.\n\n\nContact Support:\n Name: Pushwoosh",
      "type": "text/plain"
    }
  }
